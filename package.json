{
  "name": "longhai-podvoice",
  "version": "1.0.0",
  "description": "Longhai PodVoice — Obsidian 播客级有声笔记插件：将笔记转换为高品质语音（默认支持火山引擎豆包语音），本地保存并与笔记双向关联。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tts",
    "text-to-speech",
    "volcengine",
    "doubao",
    "note-audio",
    "podcast"
  ],
  "author": "龙海",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.3"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
